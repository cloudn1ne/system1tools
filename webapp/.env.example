# Copy to .env (this file is read directly by vite.config.ts).
# .env is git-ignored because it holds the API key.
LITELLM_API_KEY=your-litellm-key-here
LITELLM_BASE_URL=https://ai.warp.at
LITELLM_MODEL=laya

# --- how requests reach the endpoint -------------------------------------------
# Decided from the environment at server start; there is no proxy setting in the
# UI. A browser cannot route a single fetch() through a proxy, so when one is
# configured the request is routed through the server relay (/__relay), which
# forwards from node. With no proxy configured the relay is still used, because
# it also removes the CORS question. Restart the server after changing these.
#
#   set a proxy        -> relay + that proxy   (HTTPS_PROXY / ALL_PROXY / HTTP_PROXY)
#   no proxy set       -> relay, direct from the server
#   NO_PROXY matches   -> relay, direct from the server (proxy skipped)
#   NET_TRANSPORT=...  -> force a path, e.g. direct for static hosting
#
# Both plain and shell-style names work (https_proxy too). .env beats the
# inherited shell environment.
#HTTPS_PROXY=http://user:pass@proxy.internal:3128
#ALL_PROXY=http://proxy.internal:3128
#NO_PROXY=localhost,127.0.0.1,.internal
#NET_TRANSPORT=direct

# The relay refuses any target outside this allowlist, so the dev server cannot
# be used as a general proxy. LITELLM_BASE_URL is always allowed; add others
# here if you point the UI at a different host at runtime.
#RELAY_ALLOWED_ORIGINS=https://ai.warp.at,https://ai1.warp.at:8003
